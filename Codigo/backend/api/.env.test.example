# Copie este arquivo para .env.test e preencha com seus valores.
# Os testes de integração leem DATABASE_URL deste arquivo (via TEST_DATABASE_URL ou DATABASE_URL).

# Banco exclusivo para testes — NÃO use o banco de desenvolvimento/produção.
TEST_DATABASE_URL="postgresql://usuario:senha@localhost:5432/mobu_test"

# Pode usar o mesmo valor do .env principal (ou um dedicado para testes)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/mobu_test"

# Chave JWT de teste (mínimo 32 caracteres) — sobrescrita automaticamente pelo helper
JWT_SECRET="test-jwt-secret-min-32-chars-long-key!"

# Qualquer valor — a chamada real à API de Mapas é mockada nos testes
GOOGLE_MAPS_API_KEY="test-google-maps-key"
