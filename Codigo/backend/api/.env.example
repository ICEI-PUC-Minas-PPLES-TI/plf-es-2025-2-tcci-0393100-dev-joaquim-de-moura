DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/mobu?schema=public"
JWT_SECRET="generate-a-strong-secret-with-at-least-32-characters"
GOOGLE_MAPS_API_KEY="your-google-maps-server-key"
CORS_ORIGIN="http://localhost:3001,http://127.0.0.1:3001"
PORT=3000

# E-mail (Gmail SMTP)
# Crie uma "Senha de app" em: myaccount.google.com → Segurança → Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua-senha-de-app-16-digitos
SMTP_FROM="MobU <seuemail@gmail.com>"
