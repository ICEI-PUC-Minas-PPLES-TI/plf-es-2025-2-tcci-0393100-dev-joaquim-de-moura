generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  phone                  String                  @unique
  name                   String?
  role                   UserRole                @default(PASSENGER)
  createdAt              DateTime                @default(now())
  passwordHash           String
  email                  String?                 @unique
  phoneVerifiedAt        DateTime?
  emailVerifiedAt        DateTime?
  blocked                Boolean                 @default(false)
  blockedAt              DateTime?
  profilePhotoUrl        String?
  fcmToken               String?
  driverProfile          DriverProfile?
  passengerProfile       PassengerProfile?
  driverReviews          Review[]                @relation("DriverReviews")
  passengerReviews       Review[]                @relation("PassengerReviews")
  driverRides            Ride[]                  @relation("DriverRides")
  passengerRides         Ride[]                  @relation("PassengerRides")
  supportTickets         SupportTicket[]         @relation("TicketCreator")
  verificationChallenges VerificationChallenge[]
  driverSettlements      DriverSettlement[]      @relation("DriverSettlements")
  adminSettlements       DriverSettlement[]      @relation("AdminSettlements")
  driverPaymentRequests  DriverPaymentRequest[]  @relation("DriverPaymentRequests")
  adminPaymentReviews    DriverPaymentRequest[]  @relation("AdminPaymentReviews")
}

model PassengerProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  cpf                   String   @unique
  birthDate             DateTime
  emergencyContactName  String?
  emergencyContactPhone String?
  accessibilityNotes    String?
  termsAcceptedAt       DateTime
  privacyAcceptedAt     DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationChallenge {
  id          String              @id @default(cuid())
  userId      String
  channel     VerificationChannel
  destination String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
}

model DriverProfile {
  id              String               @id @default(cuid())
  userId          String               @unique
  online          Boolean              @default(false)
  available       Boolean              @default(false)
  currentLat      Float?
  currentLng      Float?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  approvalStatus  DriverApprovalStatus @default(PENDING)
  approvedAt      DateTime?
  cnhCategory     String?
  cnhImageUrl     String?
  cnhNumber       String?
  hasEar          Boolean?
  rejectionReason String?
  pixQrPayload    String?
  pixKey          String?
  pixQrCodeUrl    String?
  vehicleModel    String?
  vehiclePlate    String?
  vehicleColor    String?
  cnhExpiresAt    DateTime?
  cpf             String?
  vehicleCapacity Int?
  vehicleYear     Int?
  profilePhotoUrl String?
  user            User                 @relation(fields: [userId], references: [id])
  rejections      RideRejection[]
}

model Ride {
  id                    String          @id @default(cuid())
  passengerId           String
  driverId              String?
  status                RideStatus      @default(PENDING_DRIVER)
  createdAt             DateTime        @default(now())
  destLat               Float
  destLng               Float
  originLat             Float
  originLng             Float
  distanceMeters        Int?
  durationSeconds       Int?
  estimatedFareCents    Int?
  pricingConfigId       String?
  updatedAt             DateTime        @updatedAt
  destinationAddress    String?
  originAddress         String?
  paymentMethod         PaymentMethod   @default(CASH)
  paymentStatus         PaymentStatus   @default(PENDING)
  paymentPixPayload     String?
  paymentTxId           String?
  paymentReceiptNote    String?
  paymentReportedAt     DateTime?
  paymentConfirmedAt    DateTime?
  paymentConfirmedBy    String?
  acceptedAt            DateTime?
  driverArrivingAt      DateTime?
  driverArrivedAt       DateTime?
  startedAt             DateTime?
  finishedAt            DateTime?
  canceledAt            DateTime?
  shareToken            String?         @unique
  driverReceivableCents Int?
  platformFeeCents      Int?
  review                Review?
  driver                User?           @relation("DriverRides", fields: [driverId], references: [id])
  passenger             User            @relation("PassengerRides", fields: [passengerId], references: [id])
  pricingConfig         PricingConfig?  @relation(fields: [pricingConfigId], references: [id])
  auditLogs             RideAuditLog[]
  rejections            RideRejection[]
  supportTickets        SupportTicket[]
  messages              ChatMessage[]

  @@index([status])
  @@index([paymentStatus])
  @@index([passengerId, createdAt])
  @@index([driverId, status])
}

model RideAuditLog {
  id          String   @id @default(cuid())
  rideId      String
  actorUserId String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
}

model Review {
  id          String   @id @default(cuid())
  rideId      String   @unique
  passengerId String
  driverId    String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  driver      User     @relation("DriverReviews", fields: [driverId], references: [id])
  passenger   User     @relation("PassengerReviews", fields: [passengerId], references: [id])
  ride        Ride     @relation(fields: [rideId], references: [id])

  @@index([driverId])
  @@index([passengerId])
}

model SupportTicket {
  id          String              @id @default(cuid())
  creatorId   String
  rideId      String?
  type        SupportTicketType   @default(OTHER)
  status      SupportTicketStatus @default(OPEN)
  subject     String
  description String
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  closedAt    DateTime?
  creator     User                @relation("TicketCreator", fields: [creatorId], references: [id])
  ride        Ride?               @relation(fields: [rideId], references: [id])

  @@index([creatorId])
  @@index([rideId])
  @@index([status])
}

model ChatMessage {
  id         String     @id @default(cuid())
  rideId     String
  senderId   String
  senderRole SenderRole
  content    String
  sentAt     DateTime   @default(now())
  readAt     DateTime?
  ride       Ride       @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, sentAt])
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  discountPercent Int?      // 0-100
  discountCents   Int?      // fixed discount in cents
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
}

model OperationRegion {
  id             String          @id @default(cuid())
  name           String
  city           String?
  active         Boolean         @default(true)
  centerLat      Float?
  centerLng      Float?
  radiusMeters   Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  pricingConfigs PricingConfig[]
}

model RideRejection {
  id        String        @id @default(cuid())
  rideId    String
  driverId  String
  createdAt DateTime      @default(now())
  driver    DriverProfile @relation(fields: [driverId], references: [id])
  ride      Ride          @relation(fields: [rideId], references: [id])

  @@unique([rideId, driverId])
}

model PricingConfig {
  id                 String           @id @default(cuid())
  isActive           Boolean          @default(true)
  baseFareCents      Int              @default(500)
  perKmCents         Int              @default(200)
  perMinuteCents     Int              @default(50)
  minimumFareCents   Int              @default(800)
  bookingFeeCents    Int              @default(0)
  surgeMultiplier    Float            @default(1.0)
  currency           String           @default("BRL")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  name               String?
  regionId           String?
  platformFeePercent Float            @default(20.0)
  region             OperationRegion? @relation(fields: [regionId], references: [id])
  rides              Ride[]

  @@index([isActive])
  @@index([regionId, isActive])
}

enum RideStatus {
  PENDING_DRIVER
  ACCEPTED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum SenderRole {
  PASSENGER
  DRIVER
}

model DriverSettlement {
  id               String               @id @default(cuid())
  driverId         String
  amountCents      Int
  notes            String?
  method           String               @default("PIX")
  settledAt        DateTime             @default(now())
  settledBy        String
  paymentRequestId String?              @unique
  driver           User                 @relation("DriverSettlements", fields: [driverId], references: [id])
  settledByUser    User                 @relation("AdminSettlements", fields: [settledBy], references: [id])
  paymentRequest   DriverPaymentRequest? @relation(fields: [paymentRequestId], references: [id])

  @@index([driverId])
  @@index([settledAt])
}

model DriverPaymentRequest {
  id              String               @id @default(cuid())
  driverId        String
  amountCents     Int
  status          PaymentRequestStatus @default(PENDING)
  notes           String?
  receiptUrl      String?
  requestedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?
  driver          User                 @relation("DriverPaymentRequests", fields: [driverId], references: [id])
  reviewer        User?                @relation("AdminPaymentReviews", fields: [reviewedBy], references: [id])
  settlement      DriverSettlement?

  @@index([driverId])
  @@index([status])
  @@index([requestedAt])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum PaymentMethod {
  CASH
  PIX
}

enum PaymentStatus {
  PENDING
  RECEIVED
  NOT_RECEIVED
  CANCELED
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum VerificationChannel {
  SMS
  EMAIL
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportTicketType {
  PAYMENT
  RIDE_CANCELLATION
  SAFETY
  APP_ISSUE
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum PaymentRequestStatus {
  PENDING
  CONFIRMED
  REJECTED
}
