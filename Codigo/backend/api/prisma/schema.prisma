// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  name         String?
  role         UserRole @default(PASSENGER)
  passwordHash String
  createdAt    DateTime @default(now())

  driverProfile  DriverProfile?

  passengerRides Ride[] @relation("PassengerRides")
  driverRides    Ride[] @relation("DriverRides")
}

model DriverProfile {
  id                String               @id @default(cuid())
  userId            String               @unique

  online            Boolean              @default(false)
  available         Boolean              @default(false)

  cnhImageUrl       String?
  cnhNumber         String?
  cnhCategory       String?
  hasEar            Boolean? // EAR = exerce atividade remunerada

  approvalStatus    DriverApprovalStatus @default(PENDING)
  approvedAt        DateTime?
  rejectionReason   String?

  currentLat        Float?
  currentLng        Float?

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  rejections        RideRejection[]
}

model Ride {
  id                 String      @id @default(cuid())
  passengerId        String
  driverId           String?
  status             RideStatus  @default(PENDING_DRIVER)

  originLat          Float
  originLng          Float
  destLat            Float
  destLng            Float

  originAddress      String?
  destinationAddress String?

  distanceMeters     Int?
  durationSeconds    Int?
  estimatedFareCents Int?

  pricingConfigId    String?
  pricingConfig      PricingConfig? @relation(fields: [pricingConfigId], references: [id])

  passenger          User        @relation("PassengerRides", fields: [passengerId], references: [id])
  driver             User?       @relation("DriverRides", fields: [driverId], references: [id])

  rejections         RideRejection[]

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model RideRejection {
  id        String        @id @default(cuid())
  rideId    String
  driverId  String
  createdAt DateTime      @default(now())

  ride      Ride          @relation(fields: [rideId], references: [id])
  driver    DriverProfile @relation(fields: [driverId], references: [id])

  @@unique([rideId, driverId])
}

model PricingConfig {
  id               String   @id @default(cuid())
  isActive         Boolean  @default(true)

  baseFareCents    Int      @default(500)
  perKmCents       Int      @default(200)
  perMinuteCents   Int      @default(50)
  minimumFareCents Int      @default(800)
  bookingFeeCents  Int      @default(0)
  surgeMultiplier  Float    @default(1.0)

  currency         String   @default("BRL")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rides            Ride[]
}

enum RideStatus {
  PENDING_DRIVER
  ACCEPTED
  IN_PROGRESS
  FINISHED
  CANCELED
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}